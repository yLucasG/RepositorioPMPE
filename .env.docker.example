# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha os valores.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Senha do Postgres local (invente uma forte, não precisa lembrar — fica só nesse arquivo)
POSTGRES_PASSWORD=

# Usuário/nome do banco (pode deixar os padrões abaixo, comentados)
# POSTGRES_USER=repositorio
# POSTGRES_DB=repositorio

# Segredo usado pra assinar os tokens de login admin (string aleatória longa, ex:
# gere com `openssl rand -base64 48` ou `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`)
JWT_SECRET=

# Chave da API do Gemini, pra extração automática de dados dos PDFs por IA.
# Se deixar em branco, o sistema funciona normal, só sem a extração automática
# (os campos do formulário de cadastro precisam ser preenchidos manualmente).
GEMINI_API_KEY=

# Porta em que o site vai responder na máquina do DTEC (http://localhost:PORTA)
APP_PORT=3000

# Só necessário se forem expor o site na internet com domínio próprio e HTTPS
# (docker compose --profile public up -d). Precisa já estar com o DNS apontando
# pro IP público do DTEC antes de subir, senão o Let's Encrypt falha ao emitir
# o certificado. Deixe em branco se for usar só dentro da rede interna por enquanto.
DOMAIN=
